# ---------------------------------------------------------------------------
# Datasets are NOT in this repository. This project is deliberately
# self-contained (no cross-repo dependency on Paper1 / anchor-scope), but the
# image corpora are too large to track. See README.md "Data provenance" for how
# to obtain each one.
# ---------------------------------------------------------------------------
# TPDD tobacco images (52 MB; splits 1295/138/138)
data/tpdd/
# TLD tobacco-leaf images (178 MB)
data/tld_images/
# PlantVillage tomato subset (313 MB)
data/plantvillage_tomato/
# 828 MB archive
data/Plant_leaf_diseases_dataset_without_augmentation.zip
# superseded outputs, kept out of the audit trail
data/_stale/
*.bak

# Vendored third-party reference implementations (LP++ etc). These are external
# code, not ours to version; clone them from their own repositories.
reference_lpp/

# Generated artifacts. Regenerate with: python3 generate_figures.py
manuscript/paper/figures/
logs/

# ---------------------------------------------------------------------------
# Local / non-artifact state that should not enter version control.
# ---------------------------------------------------------------------------
# ARIS agent tracing state
.aris/
# Local pre-change snapshots of data stores (kept out of the audit trail,
# EXCEPT the two review-re-run snapshots which the manuscript cites as
# pre-re-run provenance)
data/*.pre_*
!data/coop_official.json.pre_canonical_store
!data/lp_plus_plus.json.pre_cache_repoint
# Transient caches
data/cache_freshness.json
data/reference_audit_cache.json
# Raw corn image subset (58 MB) -- obtain per README "Data provenance"
data/plantvillage_corn/
# Generated review sidecars (keep the .md / .json sources)
manuscript/paper/KILL_ARGUMENT.html
manuscript/paper/PAPER_CLAIM_AUDIT.html
manuscript/paper/PAPER_CLAIM_AUDIT.html.review.json
manuscript/paper/CITATION_AUDIT.json
manuscript/paper/CITATION_AUDIT.md
